%% <Section Name="Input Definition">
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                                                                              %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
input.updateflags_gnss = zeros(1, 1, "logical");
input.gnsstimeoutflag = zeros(1, 1, "logical");
input.imu = zeros(1, 25);
input.gnss = zeros(1, 45);
% </Section>


%% <Section Name="Loop">
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                                                                              %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% <Subsection name="MainLoop">
for i = 1:size(gnss, 1) * 10 - 100

    
    
    % <MatlabDebug>
    gnssidx = fix((i - 1) / 10) + 1;
    % if i > 940000  && i < 1000000
    %     gnss(gnssidx, :) = gnss(gnssidx, :) * 0 ;
    % end
    gnssupdateflag = mod(i - 1, 10) == 0;
    gnsstimeoutflag = gnssupdateflag && (gnss(gnssidx, 33) == 0 || gnss(gnssidx, 38) == 0);
    
    input.updateflags_gnss = gnssupdateflag; % gps and goe update
    input.gnsstimeoutflag = gnsstimeoutflag;
    
    input.imu = imu(i, :);
    if gnssupdateflag
        input.gnss = gnss(gnssidx, :);
    else
        input.gnss = zeros(1, size(gnss, 2));
    end
    % </MatlabDebug>

    [Config, generalstatus, initstepstatus, mainstepstatus, output] = Algo_Handler(Config, generalstatus, initstepstatus, mainstepstatus, input);

    % <MatlabDebug>
    if output.updateflags_att
        att_rcd(i, :) = output.att;
    end
    if output.updateflags_att_ins
        att_ins_rcd(i, :) = output.att_ins;
    end
    if output.updateflags_dong_jing_tai
        dong_jing_tai_rcd(i, :) = output.dong_jing_tai;
    end
    if output.updateflags_goe
        goe_rcd(gnssidx, :) = output.goe;
    end
    if output.updateflags_gps
        gps_rcd(gnssidx, :) = output.gps;
    end
    if output.updateflags_imu
        imu_rcd(i, :) = output.imu;
    end
    if output.updateflags_P_fil
        P_fil_rcd(i, :) = output.P_fil;
    end
    if output.updateflags_pos
        pos_rcd(i, :) = output.pos;
    end
    if output.updateflags_vel
        vel_rcd(i, :) = output.vel;
    end
    if output.updateflags_v_ins
        v_ins_rcd(i, :) = output.v_ins;
    end
    if output.updateflags_X_fil
        X_fil_rcd(i, :) = output.X_fil;
    end
    % </MatlabDebug>

end

% <MatlabDebug>
endtime = datetime;
deltatime = endtime - begintime;
disp(deltatime)
clear begintime endtime deltatime
% </MatlabDebug>

% <MatlabDebug>
clear i gnssidx gnsstimeoutflag gnssupdateflag
clear input output
% </MatlabDebug>

% </Subsection>

% </Section>



%% ----------------------------------------------------------------------------------------------------------------------
%% 绘图处理 ， 下面的C都不要写
gps_1 = gps_rcd;
gps0 = zeros(length(gps_rcd)*10, 10);
gps000 = zeros(length(gps_rcd)*10, 10);
k = 0;
dis = zeros(length(gps_rcd), 3);
DIS = zeros(length(gps_rcd), 1);
for i = 1:length(gps_rcd) - 1
    

    for j = 1:10
        gps0((i - 1) * 10 + j, :) = gps_rcd(i, :) + (gps_rcd(i + 1, :) - gps_rcd(i, :)) / 10 * (j - 1);
        if abs((gps_rcd(i + 1, 4) - gps_rcd(i, 4)) / 10) >= 10 / 180 * pi
            gps0((i - 1) * 10 + j, 4) = gps_rcd(i, 4);
        end
    end

end
gps_rcd = gps0;
v_erro = zeros(length(gps_rcd), 3);
p_erro = zeros(length(gps_rcd), 4);
a_erro = zeros(length(gps_rcd), 1);

p_erro1 = zeros(length(gps_rcd), 4);
for i = 1:length(gps_rcd)
    p_erro(i, 1:3) = [(pos_rcd(i, 1) - gps_rcd(i, 1))*6378137, (pos_rcd(i, 2) - gps_rcd(i, 2)) * 6378137 * cos(pos_rcd(1, 1)), pos_rcd(i, 3) - gps_rcd(i, 3)];

    if abs(p_erro(i, 1)) >10000
        p_erro(i, 1:2) = [0, 0];
    end
    p_erro(i, 4) = norm(p_erro(i, 1:2));



    v_erro(i, :) = vel_rcd(i, :) - gps_rcd(i, 5:7);
    a_erro(i, 1) = att_rcd(i, 3) - gps_rcd(i, 8);
    if i > 1 && a_erro(i, 1) > 300 /180 * pi
        a_erro(i, 1) = a_erro(i, 1) - 2 * pi;
    elseif a_erro(i, 1) < -300 /180 * pi
        a_erro(i, 1) = a_erro(i, 1) + 2 * pi;
    end
end
pos_rcd1 = pos_rcd ;


%% 绘图
figure(1)
subplot(3,1,1), plot(att_rcd(1:end - 100, 1) * 180 / pi); title('俯仰角'); xlabel('更新次数'); ylabel('度');
subplot(3,1,2), plot(att_rcd(1:end - 100, 2) * 180 / pi); title('横滚角'); xlabel('更新次数'); ylabel('度');
subplot(3,1,3), plot(att_rcd(1:end - 100, 3) * 180 / pi); title('航向角'); xlabel('更新次数'); ylabel('度');


figure(4)
plot(att_rcd(1:end - 100, 3) * 180 / pi,'b'); hold on;
plot(gps_rcd(1:end - 100, 8) * 180 / pi, 'r');  hold on;
plot(gps_rcd(1:end - 100, 4) * 180 / pi, 'g');  hold on;
title('航向角'); xlabel('更新次数'); ylabel('度');
legend('组合导航','GNSS')

figure(5)
subplot(3,1,1), plot(vel_rcd(1:end - 100, 1), 'b'); hold on; plot(gps_rcd(1:end - 100, 5), 'r'); title('东向速度'); xlabel('更新次数'); ylabel('m/s');
subplot(3,1,2), plot(vel_rcd(1:end - 100, 2), 'b'); hold on; plot(gps_rcd(1:end - 100, 6), 'r'); title('北向速度'); xlabel('更新次数'); ylabel('m/s');
subplot(3,1,3), plot(vel_rcd(1:end - 100, 3), 'b'); hold on; plot(gps_rcd(1:end - 100, 7), 'r'); title('天相速度'); xlabel('更新次数'); ylabel('m/s');
legend('组合导航','GNSS')



figure(6)
subplot(3,1,1), plot(v_erro(1:end - 100, 1), 'b'); title('东向速度误差'); xlabel('更新次数'); ylabel('m/s');hold on;
subplot(3,1,2), plot(v_erro(1:end - 100, 2), 'b'); title('北向速度误差'); xlabel('更新次数'); ylabel('m/s');hold on;
subplot(3,1,3), plot(v_erro(1:end - 100, 3), 'b'); title('天向速度误差'); xlabel('更新次数'); ylabel('m/s');hold on;

figure(7)
subplot(4,1,1), plot(p_erro(1:end - 100, 1), 'b'); title('纬度误差'); xlabel('更新次数'); ylabel('m');hold on;
subplot(4,1,2), plot(p_erro(1:end - 100, 2), 'b'); title('经度误差'); xlabel('更新次数'); ylabel('m');hold on;
subplot(4,1,3), plot(p_erro(1:end - 100, 3), 'b'); title('高度误差'); xlabel('更新次数'); ylabel('m');hold on;
subplot(4,1,4), plot(p_erro(1:end - 100, 4), 'b'); title('水平误差'); xlabel('更新次数'); ylabel('m');hold on;

figure(8)
plot(p_erro(1:end - 100, 4), 'b'); title('水平误差'); xlabel('更新次数'); ylabel('m');hold on;



a4 = find(goe_rcd(:, 2) == 4);
a5 = find(goe_rcd(:, 2) == 5);
a1 = find(goe_rcd(:, 2) == 1);
a2 = find(goe_rcd(:, 2) == 2);

pos_i = find(pos_rcd(:, 1) == 0);
pos_rcd(pos_i, :) = [];
% 
diff_goe_a4 = [ 1; diff(a4)];
diff_goe_a5 = [ 1; diff(a5)];
diff_goe_a2 = [ 1; diff(a2)];
diff_goe_a1 = [ 1; diff(a1)];

a41 = find(diff_goe_a4 > 1);
a51 = find(diff_goe_a5 > 1);
a11 = find(diff_goe_a1 > 1);
a21 = find(diff_goe_a2 > 1);

aaa_rcd1 = gps_1(: , 1 : 4) ;
aaa1 = [aaa_rcd1(a4(a41, :),:); aaa_rcd1(a5(a51, :),:); aaa_rcd1(a5(a51, :),:); aaa_rcd1(a5(a51, :),:)];

aaa_rcd1(a4(a41, :),:) = nan * ones(length(a41), 4);
aaa_rcd1(a5(a51, :),:) = nan * ones(length(a51), 4);
aaa_rcd1(a1(a11, :),:) = nan * ones(length(a11), 4);
aaa_rcd1(a2(a21, :),:) = nan * ones(length(a21), 4);


figure(9)
plot(aaa_rcd1(a4, 1) * 180 / pi, aaa_rcd1(a4, 2) * 180 / pi, 'r-*'); hold on;
plot(aaa_rcd1(a5, 1) * 180 / pi, aaa_rcd1(a5, 2) * 180 / pi, 'r-o'); hold on;
plot(aaa_rcd1(a2, 1) * 180 / pi, aaa_rcd1(a2, 2) * 180 / pi, 'g-*'); hold on;
plot(aaa_rcd1(a1, 1) * 180 / pi, aaa_rcd1(a1, 2) * 180 / pi, 'g-o'); hold on;

plot(pos_rcd(:, 1) * 180 / pi, pos_rcd(:, 2) * 180 / pi, 'b-'); hold on;

plot(aaa1(:, 1) * 180 / pi, aaa1(:, 2) * 180 / pi, '^'); hold on;
legend('GNSS-4','GNSS-5','GNSS-2','GNSS-1','组合导航','模式切换处')

if length(gps_rcd) > length(pos_rcd)
    L = length(pos_rcd) ;
else
    L = length(gps_rcd) ;
end
figure(20)
plot((gps_rcd(1 : L , 1) - gps_rcd(1, 1)) * 6378137 , (gps_rcd(1 : L, 2) - gps_rcd(1, 2)) * 6378137  * cos(pos_rcd(1, 1)), 'g-'); hold on;
plot((pos_rcd(1 : L, 1) - gps_rcd(1, 1)) * 6378137 , (pos_rcd(1 : L, 2) - gps_rcd(1, 2)) * 6378137  * cos(pos_rcd(1, 1)), 'r-'); hold on;
legend('GNSS','组合导航');

% figure(10)
% plot3(pos_rcd(1:end - 100, 1), pos_rcd(1:end - 100, 2), pos_rcd(1:end - 100, 3), 'b');
% hold on;
% plot3(aaa_rcd(1:end - 100, 1), aaa_rcd(1:end - 100, 2), aaa_rcd(1:end - 100, 3), 'r');

figure(11)
subplot(3,1,1), plot(pos_rcd1(1:end - 100, 1) * 6378137  - pos_rcd1(1, 1) * 6378137, 'b'); hold on; plot(gps_rcd(1:end - 100, 1) * 6378137  - pos_rcd1(1, 1) * 6378137, 'r'); title('纬度'); xlabel('更新次数'); ylabel('m');
subplot(3,1,2), plot(pos_rcd1(1:end - 100, 2)  * 6378137 * cos(pos_rcd1(1, 1))- pos_rcd1(1, 2) * 6378137 * cos(pos_rcd1(1, 1)), 'b'); hold on; plot(gps_rcd(1:end - 100, 2) * 6378137 * cos(pos_rcd1(1, 1))- pos_rcd1(1, 2) * 6378137 * cos(pos_rcd1(1, 1)), 'r'); title('经度'); xlabel('更新次数'); ylabel('m');
subplot(3,1,3), plot(pos_rcd1(1:end - 100, 3), 'b'); hold on; plot(gps_rcd(1:end - 100, 3), 'r'); title('高度'); xlabel('更新次数'); ylabel('m');
legend('组合导航','GNSS')




