    [50/57 , 10 , 30/57 ] * 1e-1 ...
] .^ 2;
Config.KalmanParams.Q_Diag = ([[1 , 1 , 1] * 0.2e-5 , [1 , 1 , 1] * 1e-4]) .^2;
Config.KalmanParams.R_Qual1_Diag = [[1, 1, 1] * 0.02 , [1, 1, 1] * 0.02 , 0.01 / 180 * pi] .^2;
Config.KalmanParams.R_Qual2_Diag = [[1, 1, 1] * 0.02 , [1, 1, 1] * 0.02 , 0.01 / 180 * pi] .^2;
